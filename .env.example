# Copy to .env and fill in. Never commit .env.

# --- OpenAI API (summarization) ---
OPENAI_API_KEY=
# Model id is read from env and never hard-coded.
OPENAI_MODEL=gpt-5.5

# --- Hugging Face (pyannote diarization) ---
# Needs a token AND accepted model terms for:
#   pyannote/speaker-diarization-3.1
#   pyannote/segmentation-3.0
HF_TOKEN=

# --- ASR (faster-whisper) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Paths ---
DATA_DIR=data

# --- Server ---
HOST=127.0.0.1
PORT=8000
# Frontend dev server origin, allowed by CORS
CORS_ORIGINS=http://localhost:5173

# --- Bot (Google Meet) ---
BOT_PROFILE_DIR=bot/profile
BOT_DISPLAY_NAME=EchoNotes Notetaker (recording)
BOT_MAX_MINUTES=90
# Browser the bot drives: chrome (installed Google Chrome) or chromium (Playwright's build)
BOT_BROWSER=chrome
# Python that runs bot/meet_bot.py; empty means bot/.venv/bin/python
BOT_PYTHON=
# URL the bot calls back when recording finishes
BACKEND_URL=http://127.0.0.1:8000
